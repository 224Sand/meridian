{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product configuration",
  "type": "object",
  "required": ["name","slug","wordmark","tagline","description","repo","primaryDomain","agentServiceUrl","provisional"],
  "additionalProperties": true,
  "properties": {
    "name":            { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Za-z][A-Za-z0-9 ._-]*$" },
    "slug":            { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "wordmark":        { "type": "string", "minLength": 2, "maxLength": 32 },
    "tagline":         { "type": "string", "minLength": 10, "maxLength": 120 },
    "description":     { "type": "string", "minLength": 20, "maxLength": 400 },
    "repo":            { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
    "primaryDomain":   { "type": "string", "minLength": 4 },
    "agentServiceUrl": { "type": "string", "pattern": "^https://" },
    "provisional":     { "type": "boolean" }
  }
}
