# ─── LLM providers (deterministic failover order is defined in the router) ───
# Every provider below has a free tier. NFR-002 forbids paid infrastructure.
GROQ_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
CEREBRAS_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here
MISTRAL_API_KEY=your_key_here

# ─── Data ───
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ─── Media ───
PEXELS_API_KEY=your_key_here

# ─── Service wiring ───
AGENT_SERVICE_URL=http://localhost:7860
AGENT_SERVICE_TOKEN=your_shared_secret_here

# ─── Guardrails (Security review, R-04) ───
DAILY_TOKEN_CEILING=250000
PER_IP_RATE_LIMIT_PER_HOUR=20
# Per-run ceiling. Must be POSITIVE: the spend guard treats 0 as 'cannot
# spend' and refuses every live call, which is the correct default and a
# confusing runtime failure. The runtime now refuses to START on 0.
RUN_BUDGET_USD=0.02

# ─── Local-only provider (R-06): cannot run in the deployed container ───
CLAUDE_CLI_ENABLED=false
